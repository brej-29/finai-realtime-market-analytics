# Root-level environment example for FinAI - Real-Time Market Analytics
#
# NOTE:
# - The backend (FastAPI) reads its env from:   apps/api/.env
# - The frontend (Next.js) reads its env from: apps/web/.env.local
# - This file is a convenient reference; copy values into the app-specific files
#   or export them in your shell / hosting platform.

# ------------------------------------------------------------------------------
# Backend (FastAPI - apps/api)
# ------------------------------------------------------------------------------

# Database URL used by the backend.
# In production (Neon / Supabase / Render Postgres) prefer a Postgres URL:
#   postgresql+psycopg2://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./dev.db

# Optional alias sometimes used in docs; the backend itself reads DATABASE_URL.
POSTGRES_URL=${DATABASE_URL}

# Twelve Data API key (stocks) - get a free key from the Twelve Data dashboard.
TWELVE_DATA_API_KEY=your-twelvedata-api-key-here

# Optional overrides (usually keep defaults)
TWELVE_DATA_BASE_URL=https://api.twelvedata.com
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
GDELT_BASE_URL=https://api.gdeltproject.org/api/v2/doc/doc

# CORS origins for browser clients (comma-separated).
# Example for local dev + Vercel:
# BACKEND_CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app
BACKEND_CORS_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------------------
# Frontend (Next.js - apps/web)
# ------------------------------------------------------------------------------

# Base URL for the FastAPI backend (used for REST requests).
# Local dev:
#   http://localhost:8000
# Render (example):
#   https://your-api.onrender.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# WebSocket URL for realtime ticks.
# Local dev:
#   ws://localhost:8000/ws/stream
# Render (example):
#   wss://your-api.onrender.com/ws/stream
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/stream