# Environment
ENV=local
DEBUG=false
LOG_LEVEL=INFO

# Database
# For local development you can use SQLite (no external DB needed):
# DATABASE_URL=sqlite:///./dev.db
# For production (Neon / Supabase / Render Postgres), use a Postgres URL, e.g.:
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./dev.db

# Market data providers
TWELVE_DATA_API_KEY=your-twelvedata-api-key-here
TWELVE_DATA_BASE_URL=https://api.twelvedata.com
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# News provider (GDELT Doc 2.0 API)
GDELT_BASE_URL=https://api.gdeltproject.org/api/v2/doc/doc
NEWS_TTL_SECONDS=1800

# Caching & rate limiting
QUOTES_TTL_SECONDS=10
HISTORY_TTL_SECONDS=600
# Twelve Data's free tier allows 8 requests/min, 800/day (resets midnight UTC).
# These defaults match that cap so the app throttles gracefully instead of
# hitting provider 429s; loosen them if you're on a paid Twelve Data plan.
PROVIDER_RATE_LIMIT_CAPACITY=8
PROVIDER_RATE_LIMIT_REFILL_PER_SECOND=0.1333

# Realtime / WebSockets
WEBSOCKET_HEARTBEAT_INTERVAL_SECONDS=25
# 10s keeps combined polling comfortably under Twelve Data's 8/min free-tier cap.
WEBSOCKET_STREAM_INTERVAL_SECONDS=10

# Alerts scheduler
# 120s so the scheduler's own quote/history calls don't compound with the streamer's polling.
ALERTS_SCHEDULER_INTERVAL_SECONDS=120
ALERTS_MIN_EVENT_INTERVAL_SECONDS=300
ALERTS_RSI_PERIOD=14
ALERTS_MA_SHORT_WINDOW=10
ALERTS_MA_LONG_WINDOW=30

# CORS
# Comma-separated list of allowed origins for browser clients.
# Example: http://localhost:3000,https://your-frontend.vercel.app
BACKEND_CORS_ORIGINS=http://localhost:3000

# Demo data
# Seed a demo watchlist, portfolio, and alerts on startup when the database is
# empty. Recommended for free-tier demo deployments; harmless to leave on.
SEED_DEMO_DATA=false

# AI research agents (multi-agent Claude research desk + MCP server)
# Leave both keys unset to keep the /research endpoints disabled (returns 503) —
# the rest of the app works fine without it.
ANTHROPIC_API_KEY=
# claude-haiku-4-5 keeps a full 3-agent research run around a cent; upgrade to
# claude-sonnet-5 for noticeably better synthesis at higher cost.
RESEARCH_MODEL=claude-haiku-4-5

# Groq is used automatically once RESEARCH_DAILY_BUDGET_USD is hit for the day,
# or as the sole provider if ANTHROPIC_API_KEY is left unset — get a free key
# at https://console.groq.com. Also used if an Anthropic run fails outright
# (e.g. an outage) so a demo never just goes dark.
GROQ_API_KEY=
GROQ_RESEARCH_MODEL=llama-3.3-70b-versatile

# Hard cap on Anthropic spend per UTC day (estimated from actual token usage
# at the pricing in app/services/research/pricing.py). Once hit, new runs use
# the Groq fallback instead of Anthropic.
RESEARCH_DAILY_BUDGET_USD=0.20
# Secondary anti-abuse ceiling on run count, independent of cost — not the
# primary control, RESEARCH_DAILY_BUDGET_USD is.
RESEARCH_DAILY_LIMIT=50